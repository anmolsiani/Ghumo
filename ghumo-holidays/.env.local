# Database
MONGODB_URI=mongodb+srv://mocked:mocked@cluster0.mongodb.net/ghumo-holidays

# Next Auth (generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET=mock-secret-for-dev-environment
NEXTAUTH_URL=http://localhost:3000

# Admin Credentials (for seed/auth)
ADMIN_EMAIL=hello@ghumoholidays.com
ADMIN_PASSWORD=change-in-production

# Unsplash API
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=mock-unsplash-key-provide-real-key-here

# Nodemailer SMTP setup (Gmail App Password recommended)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=hello@ghumoholidays.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=hello@ghumoholidays.com
